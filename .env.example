# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from your Supabase project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Admin ─────────────────────────────────────────────────────────────────────
# The email of the sole admin user — only this account sees the Admin tab
VITE_ADMIN_EMAIL=

# ── AI (OpenRouter) ──────────────────────────────────────────────────────────
# Optional — enables the floating AI assistant. Get a key at https://openrouter.ai
VITE_OPENROUTER_API_KEY=
