{
    "name": "esp32-dev-manager",
    "description": "A comprehensive full-stack application designed to track and manage all aspects of your embedded systems development journey, with a special focus on ESP32 S3 projects.",
    "author": "Owen Erhabor <erhaborowen@gmail.com>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/owen-6936/esp32-dev-manager.git"
    },
    "bugs": {
        "url": "https://github.com/owen-6936/esp32-dev-manager/issues"
    },
    "homepage": "https://github.com/owen-6936/esp32-dev-manager#readme",
    "engines": {
        "node": "24.x"
    },
    "keywords": [
        "ESP32",
        "embedded systems",
        "development",
        "management",
        "tracking",
        "monitoring",
        "logging",
        "IoT",
        "firmware",
        "debugging"
    ],
    "private": true,
    "version": "0.1.0-beta.1",
    "type": "module",
    "packageManager": "pnpm@10.33.0",
    "scripts": {
        "dev": "vite --host",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "preview": "vite preview",
        "type-check": "tsc --noEmit",
        "format": "prettier --write .",
        "release": "pnpm run type-check && pnpm run lint && pnpm test && pnpm run build"
    },
    "dependencies": {
        "@headlessui/react": "^2.2.9",
        "@react-three/drei": "^10.7.7",
        "@react-three/fiber": "^9.5.0",
        "@supabase/supabase-js": "^2.101.1",
        "chart.js": "^4.5.1",
        "framer-motion": "^12.38.0",
        "lottie-react": "^2.4.1",
        "lucide-react": "^0.540.0",
        "prism-react-renderer": "^2.4.1",
        "react": "^19.2.4",
        "react-chartjs-2": "^5.3.1",
        "react-dom": "^19.2.4",
        "react-markdown": "^10.1.0",
        "react-router-dom": "^7.14.0",
        "react-syntax-highlighter": "^16.1.1",
        "remark-gfm": "^4.0.1",
        "three": "^0.179.1",
        "uuid": "^11.1.0",
        "zustand": "^5.0.12"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@tailwindcss/vite": "^4.2.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^24.12.2",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@types/react-syntax-highlighter": "^15.5.13",
        "@vitejs/plugin-react-swc": "^3.11.0",
        "@vitest/coverage-v8": "^4.1.4",
        "autoprefixer": "^10.4.27",
        "eslint": "^9.39.4",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.26",
        "globals": "^16.5.0",
        "jsdom": "^29.0.1",
        "postcss": "^8.5.8",
        "prettier": "^3.8.1",
        "tailwindcss": "^4.2.2",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.58.0",
        "vite": "^7.3.1",
        "vite-plugin-pwa": "^1.2.0",
        "vitest": "^4.1.2"
    }
